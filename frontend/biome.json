{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["src/**", "!src/**/*.css", "!dist/**", "!coverage/**", "!playwright-report/**", "!test-results/**"]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "noLabelWithoutControl": "warn",
        "useButtonType": "warn",
        "useKeyWithClickEvents": "warn",
        "noStaticElementInteractions": "warn",
        "noAutofocus": "warn",
        "useAriaPropsSupportedByRole": "warn",
        "useMediaCaption": "warn",
        "noSvgWithoutTitle": "warn",
        "noNoninteractiveTabindex": "warn",
        "noAmbiguousAnchorText": "warn",
        "useSemanticElements": "warn"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noArrayIndexKey": "warn",
        "useIterableCallbackReturn": "warn"
      },
      "style": {
        "useImportType": "warn",
        "noNonNullAssertion": "warn"
      },
      "correctness": {
        "usePlaywrightValidDescribeCallback": "off",
        "noUnusedImports": "warn",
        "noUnusedVariables": "warn",
        "useExhaustiveDependencies": "warn"
      },
      "complexity": {
        "noThisInStatic": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/__tests__/**", "src/test/**", "**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": false
  }
}
