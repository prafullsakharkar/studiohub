{
  "name": "studiohub-react",
  "private": true,
  "version": "3.14.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:coverage": "vitest run --coverage",
    "api:generate": "node scripts/generate-api-contract.mjs",
    "api:validate": "node scripts/validate-api-contract.mjs",
    "lint:biome": "biome check src",
    "lint:fix": "biome check --write src"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^6.0.2",
    "@mui/material": "^9.5.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.105.0",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "express": "^4.21.2",
    "http-proxy-middleware": "^4.2.1",
    "ky": "^2.2.0",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^8.3.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  },
  "description": "StudioHub frontend — VFX & Animation production management platform"
}
