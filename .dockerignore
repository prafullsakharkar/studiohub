# Git
.git
.gitignore
.gitattributes

# Environment / secrets (never copied into the image). `**/` is required so
# the patterns match files in subdirectories (e.g. backend/.env.local).
**/.env
**/.env.*

# Python. Every pattern here starts with `**/`: the Dockerfile copies `backend/`, and a pattern
# without it matches only at the root of the build context (which is how a developer's `.venv`,
# `media/` and caches once ended up inside the production image).
**/__pycache__
**/*.py[cod]
**/*.so
**/*.egg-info
**/.eggs
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.coverage
**/.coverage.*
**/*.cover
**/htmlcov
**/.pydeps

# Virtual environments
**/.venv
**/venv

# Node / frontend build artefacts
**/node_modules
**/dist
**/build

# Local databases and generated media (collectstatic runs inside the image). The media and static
# folders are named by path, not `**/`: a `**/media` pattern also dropped the Python package
# `apps/production/api/serializers/media/` from every image built since v4.1.0
# (`backend/apps/core/tests/test_image_contents.py` guards this).
**/db.sqlite3
backend/media
backend/static
backend/staticfiles
media
static
staticfiles

# Celery beat / runtime scratch files, logs
**/celerybeat-schedule*
**/*.log
**/logs

# IDEs / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# CI / tooling
.github/
scripts/
**/.serena
**/.opencode
**/.superpowers
infrastructure/compose/.env
