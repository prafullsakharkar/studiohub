# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
DJANGO_ENV=local
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# Database (PostgreSQL default; DB_ENGINE=sqlite for a local file DB)
# -----------------------------------------------------------------------------
# DB_ENGINE=sqlite
# DB_SQLITE_PATH=db.sqlite3
DB_NAME=studiohub
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=postgres
DB_PORT=5432

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
EMAIL_HOST=mailpit
EMAIL_PORT=1025
# Development catches mail in mailpit without TLS. Production sets EMAIL_USE_TLS, credentials,
# DEFAULT_FROM_EMAIL and FRONTEND_BASE_URL (see the root .env.example).
EMAIL_USE_TLS=false
FRONTEND_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Root log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Log format: empty = automatic (JSON unless DEBUG), or json / console
LOG_FORMAT=

# -----------------------------------------------------------------------------
# Celery
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Uploaded files and operator surfaces (see the root .env.example). Development: Django streams
# attachments itself; the admin site and docs are mounted automatically while DJANGO_DEBUG=true.
MEDIA_ACCEL_PREFIX=
# Review media (RP-5): uploads to versions need the celery-media worker; off by default.
REVIEW_MEDIA_ENABLED=false
# Burn-ins (RP-12) need a font; on a development host point this at a local DejaVuSans.ttf.
# REVIEW_MEDIA_BURN_IN_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# Colour management (RP-15): the OpenColorIO config; the default is the built-in ACES 2.0 one.
# REVIEW_MEDIA_OCIO_CONFIG=ocio://studio-config-v5.0.0_aces-v2.1_ocio-v2.6
# In-app notifications (RP-6): days kept before the daily purge.
NOTIFICATIONS_RETENTION_DAYS=90
ADMIN_ENABLED=false
API_DOCS_ENABLED=false

# Require MFA of every account (staff, superusers and vendor/client members always need it).
MFA_REQUIRE_ALL=false
