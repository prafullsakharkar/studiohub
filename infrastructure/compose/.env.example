# =============================================================================
# StudioHub Compose runtime environment template.
# Copy to `.env` (this directory) and fill in CHANGE_ME values.
#
# Variable names match `backend/config/env.py` (pydantic-settings).
# A full annotated template also lives at the repository root: `.env.example`.
# =============================================================================

# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
DJANGO_ENV=production
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=["CHANGE_ME.example.com"]
DJANGO_CSRF_TRUSTED_ORIGINS=["https://CHANGE_ME.example.com"]
DJANGO_CORS_ALLOWED_ORIGINS=["https://CHANGE_ME.example.com"]

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=studiohub
POSTGRES_USER=studiohub
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DB_ENGINE=postgresql
DB_NAME=studiohub
DB_USER=studiohub
DB_PASSWORD=CHANGE_ME
DB_HOST=postgres
DB_PORT=5432
# Encrypted and verified database link: the CA is the one the tls-init job creates (compose.prod.yml).
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/tls/ca.pem

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Required in production: Redis refuses to start without it. Use URL-safe characters:
#   python -c "import secrets; print(secrets.token_hex(32))"
REDIS_PASSWORD=CHANGE_ME
# Redis listens on TLS only in compose.prod.yml; the same CA verifies it.
REDIS_TLS=true
REDIS_CA_CERT=/tls/ca.pem
# `manage.py check --deploy` fails (instead of warning) if the database or Redis link is not encrypted.
INTERNAL_TLS_REQUIRED=true

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
EMAIL_HOST=CHANGE_ME.smtp.host
EMAIL_PORT=587
# Authenticated relay over STARTTLS (587) or implicit TLS (EMAIL_USE_SSL=true with 465). Mail without
# TLS fails `manage.py check --deploy`.
EMAIL_HOST_USER=CHANGE_ME
EMAIL_HOST_PASSWORD=CHANGE_ME
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@CHANGE_ME.example.com
# Origin of the web client; reset emails link to <this>/reset-password?token=...
FRONTEND_BASE_URL=https://CHANGE_ME.example.com

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# Celery
# -----------------------------------------------------------------------------
# Same password as REDIS_PASSWORD (`manage.py check --deploy` fails without it).
CELERY_BROKER_URL=rediss://:CHANGE_ME@redis:6379/1
CELERY_RESULT_BACKEND=rediss://:CHANGE_ME@redis:6379/2

# -----------------------------------------------------------------------------
# Uvicorn
# -----------------------------------------------------------------------------
WEB_CONCURRENCY=2
# The compose `backend` subnet (compose.prod.yml), where nginx runs. The application trusts
# X-Forwarded-For only from here; uvicorn uses the same range. Empty makes every client look like
# the proxy (check --deploy warns).
TRUSTED_PROXY_IPS=172.31.250.0/24
FORWARDED_ALLOW_IPS=172.31.250.0/24

# -----------------------------------------------------------------------------
# Uploaded files and operator surfaces
# -----------------------------------------------------------------------------
# nginx `internal` location that maps to the media volume. With it, attachments are handed to nginx
# only after the application has authorized a signed download link.
MEDIA_ACCEL_PREFIX=/_protected_media

# Off in production. The admin login does not use the API's MFA or lockout; /admin/ and
# /api/schema are also blocked by the proxy. Enable only behind a private network.
ADMIN_ENABLED=false
API_DOCS_ENABLED=false

# -----------------------------------------------------------------------------
# Secrets that protect stored data. `manage.py check --deploy` fails without the first and the third.
# -----------------------------------------------------------------------------
# Fernet key protecting MFA (TOTP) secrets at rest. Required for MFA to work; MFA fails closed without it.
# Comma-separate several keys to rotate (the first encrypts, all decrypt). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
# Leave true. false stores MFA secrets in plaintext (`check` warns); turn back on with `manage.py mfa_encrypt_secrets`.
MFA_ENCRYPTION_ENABLED=true

# Fernet key(s) protecting delivery passcodes at rest (a different key from MFA's, on purpose). Setting or reading a
# passcode fails closed (503) without it; deliveries without a passcode work. Generate like MFA_ENCRYPTION_KEY.
DELIVERY_SECRET_KEY=

# Fernet key(s) protecting the directory (LDAP) service account's password at rest (ADR-0039; a different key again).
# Without it the password cannot be saved, so directory sign-in stays off. Generate like MFA_ENCRYPTION_KEY.
DIRECTORY_ENCRYPTION_KEY=
# true turns directory sign-in off whatever Settings -> System -> Directory (LDAP) says (an emergency off).
DIRECTORY_LOGIN_FORCE_OFF=false

# Dedicated pepper for API key / personal access token digests (HMAC-SHA256). Required to create or verify credentials.
# A long random value, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it invalidates every stored credential.
API_KEY_PEPPER=
# A new environment has no credentials stored with the old digest: false. Set true only while carrying old credentials over
# (`manage.py legacy_credentials`); `manage.py check --deploy` warns while it is true.
API_KEY_ACCEPT_LEGACY_HASH=false

# -----------------------------------------------------------------------------
# MFA scope
# -----------------------------------------------------------------------------
# Staff, superusers and vendor/client project members always need MFA. true: everyone does.
# A user who owes MFA enrollment (or a password change) holds a restricted session until done.
MFA_REQUIRE_ALL=true

# Minutes of no authenticated request after which a session cannot be refreshed and ends (0 = off).
SESSION_IDLE_TIMEOUT_MINUTES=120

# Passwords: screen new ones against known breaches (k-anonymity: only 5 hash characters leave the server;
# adds an outbound HTTPS call to api.pwnedpasswords.com). PASSWORD_BREACH_CHECK_FAIL_CLOSED=true refuses
# a new password while that service is unreachable.
PASSWORD_BREACH_CHECK=true
PASSWORD_BREACH_CHECK_FAIL_CLOSED=false

# Hourly summary (counts only) of failed-login spikes, lockouts and privileged changes, comma separated.
# Empty: alerts go only to the log (event: security_alert).
SECURITY_ALERT_EMAILS=

# Days audit tables keep their rows before the daily purge removes them (0 = keep forever).
AUDIT_RETENTION_DAYS=730
API_REQUEST_RETENTION_DAYS=180
TRACK_RETENTION_DAYS=90
