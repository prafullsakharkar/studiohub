{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "permission": {
    "lsp": "allow"
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest"
        ]
      }
    }
  },
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek V4 Flash - llama.cpp",
      "options": {
        "baseURL": "http://192.168.1.238:8080/v1",
        "apiKey": "local-dev-key"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (Local)",
          "limit": {
            "context": 115536,
            "output": 16384
          }
        }
      }
    },
    "llama-glm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "GLM 5.3 Flash - llama.cpp",
      "options": {
        "baseURL": "http://192.168.1.238:8080/v1",
        "apiKey": "local-dev-key"
      },
      "models": {
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash (Local)",
          "limit": {
            "context": 105000,
            "output": 16384
          }
        }
      }
    },
    "llama-qwen": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Qwen3-Coder-Next - llama.cpp",
      "options": {
        "baseURL": "http://192.168.1.238:8080/v1",
        "apiKey": "local-dev-key"
      },
      "models": {
        "Qwen3-Coder-Next": {
          "name": "Qwen3-Coder-Next (Local)",
          "limit": {
            "context": 250000,
            "output": 16384
          }
        }
      }
    }
  }
}