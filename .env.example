# =============================================================================
# StudioHub runtime environment template.
# Copy to `.env` (or `infrastructure/compose/.env` when using the Compose
# overlay) and replace every CHANGE_ME value before deploying.
#
# Variable names match the actual Django settings loader in
# `backend/config/env.py` (pydantic-settings). Do not rename them.
# =============================================================================

# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
# Runtime environment: local | docker | testing | production | ci
DJANGO_ENV=production
# Python settings module (config.settings.*)
DJANGO_SETTINGS_MODULE=config.settings.production
# REQUIRED. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE_ME
# Must be false in production.
DJANGO_DEBUG=False
# JSON array of allowed host/domain names.
DJANGO_ALLOWED_HOSTS=["CHANGE_ME.example.com"]
# JSON array of CSRF-trusted origins (scheme://host[:port]).
DJANGO_CSRF_TRUSTED_ORIGINS=["https://CHANGE_ME.example.com"]
# JSON array of CORS-allowed origins (frontend origin).
DJANGO_CORS_ALLOWED_ORIGINS=["https://CHANGE_ME.example.com"]

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# POSTGRES_* are consumed by the postgres container to initialise the server.
POSTGRES_DB=studiohub
POSTGRES_USER=studiohub
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# DB_* are consumed by Django and MUST match the POSTGRES_* values above.
# DB_ENGINE=sqlite can be used for a local file database (DB_SQLITE_PATH).
DB_ENGINE=postgresql
DB_NAME=studiohub
DB_USER=studiohub
DB_PASSWORD=CHANGE_ME
DB_HOST=postgres
DB_PORT=5432
# Production: DB_SSLMODE=verify-full with DB_SSLROOTCERT=<CA file> (see infrastructure/compose/.env.example).
# DB_SSLMODE=
# DB_SSLROOTCERT=

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Required in production: Redis refuses to start without it. Use URL-safe characters:
#   python -c "import secrets; print(secrets.token_hex(32))"
REDIS_PASSWORD=CHANGE_ME
# Production: REDIS_TLS=true, REDIS_CA_CERT=<CA file>, rediss:// Celery URLs, INTERNAL_TLS_REQUIRED=true.
# REDIS_TLS=false
# REDIS_CA_CERT=
# INTERNAL_TLS_REQUIRED=false

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
EMAIL_HOST=CHANGE_ME.smtp.host
EMAIL_PORT=587
# Authenticated relay over STARTTLS (587) or implicit TLS (EMAIL_USE_SSL=true with 465). Mail without
# TLS fails `manage.py check --deploy`.
EMAIL_HOST_USER=CHANGE_ME
EMAIL_HOST_PASSWORD=CHANGE_ME
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@CHANGE_ME.example.com
# Origin of the web client; reset emails link to <this>/reset-password?token=...
FRONTEND_BASE_URL=https://CHANGE_ME.example.com

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Empty = automatic (JSON in production), or json / console.
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# Celery
# -----------------------------------------------------------------------------
# Same password as REDIS_PASSWORD (`manage.py check --deploy` fails without it).
CELERY_BROKER_URL=redis://:CHANGE_ME@redis:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME@redis:6379/2

# -----------------------------------------------------------------------------
# Uvicorn
# -----------------------------------------------------------------------------
# Number of Uvicorn worker processes.
WEB_CONCURRENCY=2
# The compose `backend` subnet (compose.prod.yml), where nginx runs; comma-separate IPs/CIDRs. The
# application trusts X-Forwarded-For only from here (the client IP for lockout, throttling and audit
# is the first untrusted hop) and uvicorn uses the same range. Leave empty only without a proxy:
# otherwise every client looks like the proxy (check --deploy warns).
TRUSTED_PROXY_IPS=172.31.250.0/24
FORWARDED_ALLOW_IPS=172.31.250.0/24

# Fernet key protecting MFA (TOTP) secrets at rest. Required for MFA to work;
# MFA fails closed without it. Comma-separate several keys to rotate (the first
# encrypts, all decrypt). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
# Set to false to store MFA secrets in plaintext (default true). Turn back on with
# `manage.py mfa_encrypt_secrets` to convert what was stored meanwhile.
MFA_ENCRYPTION_ENABLED=true

# Fernet key(s) protecting delivery passcodes at rest (a different key from MFA's, on purpose).
# Setting or reading a passcode fails closed (503) without it; deliveries without a passcode work.
# Required before migrating deliveries 0009 if any delivery has a passcode. Comma-separate to
# rotate (the first encrypts, all decrypt). Generate like MFA_ENCRYPTION_KEY above.
DELIVERY_SECRET_KEY=

# Dedicated pepper for API key / personal access token digests (HMAC-SHA256).
# Required to create or verify credentials. Use a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it invalidates every stored credential.
API_KEY_PEPPER=
# Keys/tokens stored with the old digest still work while this is true. Run
# `manage.py legacy_credentials` (add --revoke to revoke what it lists), then set false.
# `manage.py check --deploy` warns while it is true.
API_KEY_ACCEPT_LEGACY_HASH=true

# -----------------------------------------------------------------------------
# Uploaded files and operator surfaces
# -----------------------------------------------------------------------------
# nginx `internal` location that maps to the media volume. With it, attachments are handed to nginx
# only after the application has authorized a signed download link.
MEDIA_ACCEL_PREFIX=/_protected_media

# Off in production. The admin login does not use the API's MFA or lockout; /admin/ and
# /api/schema are also blocked by the proxy. Enable only behind a private network.
ADMIN_ENABLED=false
API_DOCS_ENABLED=false

# -----------------------------------------------------------------------------
# MFA scope
# -----------------------------------------------------------------------------
# Staff, superusers and vendor/client project members always need MFA. true: everyone does.
# A user who owes MFA enrollment (or a password change) holds a restricted session until done.
MFA_REQUIRE_ALL=true

# -----------------------------------------------------------------------------
# Sessions
# -----------------------------------------------------------------------------
# Minutes of no authenticated request after which a session cannot be refreshed and ends (0 = off).
# Access tokens last 30 minutes and refresh tokens 7 days; a session ends 30 days after it began.
SESSION_IDLE_TIMEOUT_MINUTES=120

# Passwords: screen new ones against known breaches (k-anonymity: only 5 hash characters leave the server;
# adds an outbound HTTPS call to api.pwnedpasswords.com). PASSWORD_BREACH_CHECK_FAIL_CLOSED=true refuses
# a new password while that service is unreachable.
PASSWORD_BREACH_CHECK=false
PASSWORD_BREACH_CHECK_FAIL_CLOSED=false

# Hourly summary (counts only) of failed-login spikes, lockouts and privileged changes, comma separated.
# Empty: alerts go only to the log (event: security_alert).
SECURITY_ALERT_EMAILS=

# Days audit tables keep their rows before the daily purge removes them (0 = keep forever).
AUDIT_RETENTION_DAYS=730
API_REQUEST_RETENTION_DAYS=180
TRACK_RETENTION_DAYS=90
